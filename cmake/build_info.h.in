// AUTO-GENERATED by cmake/build_info.cmake — do NOT edit by hand.
// Regenerated on every CMake configure with the current git state.
// This file is gitignored; its presence in a working tree just
// means "you've run cmake since the last clean."
//
// Use these constants to tag saved artifacts (telemetry sessions,
// screenshots, replay files) with the exact build they came from.
// Dirty working trees are flagged in DESCRIBE so you can tell a
// reproducible session from a local-edit one.

#pragma once

namespace logosphere {

// Short hex SHA of the HEAD commit, 10 chars. "unknown" if cmake
// ran outside a git checkout.
inline constexpr const char* kBuildSha       = "@LOGOSPHERE_BUILD_SHA@";

// `git describe --tags --dirty --always` output. Prefers the nearest
// tag (e.g., v0.3.0-12-gb7b9e2a) when one exists, falls back to a
// short SHA otherwise, and appends "-dirty" if the working tree has
// uncommitted edits. This is the human-readable version stamp.
inline constexpr const char* kBuildDescribe  = "@LOGOSPHERE_BUILD_DESCRIBE@";

// Wall-clock UTC at CMake-configure time. Not the binary's
// compilation timestamp (CMake runs once per configure, not once
// per rebuild) but close enough for session tagging.
inline constexpr const char* kBuildTimestamp = "@LOGOSPHERE_BUILD_TIMESTAMP@";

} // namespace logosphere
